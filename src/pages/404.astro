---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Página no encontrada" description="La página que buscas no existe.">
  <div class="flex min-h-screen flex-col items-center justify-center px-4 text-center">
    <h1 class="text-8xl font-bold text-emerald-400 font-mono">404</h1>
    <p class="mt-4 text-xl text-gray-400">Esta página no existe (aún).</p>
    <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-3 text-sm font-medium text-white transition hover:bg-emerald-400">
      ← Volver al inicio
    </a>
  </div>
</Layout>
