---
import ExperienceItem from "./ExperienceItem.astro";
import BriefcaseIcon from "../icons/Briefcase.astro";
import { getI18N } from "../i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const EXPERIENCE = i18n.EXPERIENCE;
---

<div class="flex flex-col">
  <div class="mb-12">
    <h2
      class="inline-flex items-center gap-3 text-2xl font-bold text-gray-100"
    >
      <BriefcaseIcon class="size-6 text-emerald-400" />
      {i18n.HOME.EXPERIENCE}
      <span class="h-px flex-1 bg-gray-800 ml-2"></span>
    </h2>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      EXPERIENCE.map((exp, index) => (
        <div class={index === 0 ? "md:col-span-2 lg:col-span-3" : ""}>
          <ExperienceItem {...exp} featured={index === 0} />
        </div>
      ))
    }
  </div>
</div>
