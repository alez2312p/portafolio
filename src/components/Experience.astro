---
import ExperienceItem from "./ExperienceItem.astro";
import BriefcaseIcon from "../icons/Briefcase.astro";
import { getI18N } from "../i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const EXPERIENCE = i18n.EXPERIENCE;
---

<div class="flex flex-col">
  <h2
    class="flex items-center text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
  >
    <BriefcaseIcon class="size-7" />
    {i18n.HOME.EXPERIENCE}
  </h2>
  <article>
    <ol class="relative mt-16">
      {
        EXPERIENCE.map((EXPERIENCE) => (
          <li>
            <ExperienceItem {...EXPERIENCE} />
          </li>
        ))
      }
    </ol>
  </article>
</div>
