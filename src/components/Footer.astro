---
import { getI18N } from "../i18n";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<footer class="border-t border-gray-800 mt-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-sm text-gray-400">
        &copy; {new Date().getFullYear()} Alejandro P. Lezama
      </p>
      <div class="flex items-center gap-4 text-sm text-gray-400">
        <a
          href="mailto:alejandropl2509@gmail.com"
          class="hover:text-emerald-400 transition-colors"
        >
          {i18n.FOOTER.CONTACT}
        </a>
        <a
          href="https://github.com/alez2312p"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-emerald-400 transition-colors"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
