---
import CodeIcon from "../icons/Code.astro";
import ProjectCard from "./ProjectCard.astro";
import { getI18N } from "../i18n";
import { TAGSLIST } from "./Tags.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

type TagKey = keyof typeof TAGSLIST;

interface CaseStudyData {
  PROBLEM: string;
  SOLUTION: string;
  ARCHITECTURE: string;
  RESULTS: string;
}

type ProjectStatus = "mvp" | "production" | "educational" | "archived";

interface Project {
  IMAGE: string;
  TITLE: string;
  DESCRIPTION: string;
  TAGS: TagKey[];
  LINK: string;
  GITHUB: string;
  PRIVATE?: boolean;
  STATUS?: ProjectStatus;
  TYPE?: "web" | "mobile" | "backend";
  EXPO_LINK?: string;
  CASE_STUDY?: CaseStudyData;
}

const PROJECTS: Project[] = i18n.PROJECTS.map((project: any) => ({
  ...project,
  TAGS: project.TAGS as TagKey[],
  TYPE: project.TYPE as "web" | "mobile" | "backend" | undefined,
}));
---

<div class="flex flex-col">
  <div class="mb-12">
    <h2
      class="inline-flex items-center gap-3 text-2xl font-bold text-gray-100"
    >
      <CodeIcon class="size-6 text-emerald-400" />
      {i18n.HOME.PROJECTS}
      <span class="h-px flex-1 bg-gray-800 ml-2"></span>
    </h2>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      PROJECTS.map((project) => (
        <ProjectCard {...project} />
      ))
    }
  </div>
</div>
