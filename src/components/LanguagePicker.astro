---
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils.ts";

import { languages } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

{
Object.entries(languages).map(([langPrefiex, label]) => {
    if (langPrefiex === lang) return <></>
    return(<a
    class="relative block px-2 py-2 text-sm transition text-gray-400 hover:text-emerald-400"
     href={translatePath("/", langPrefiex)}>{label}</a>)
    })
}
