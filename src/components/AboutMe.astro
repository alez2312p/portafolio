---
import ProfileCheckIcon from "../icons/ProfileCheck.astro";
import { Image } from "astro:assets";
import { getI18N } from "../i18n";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const ABOUT = i18n.ABOUT;
---

<div class="flex flex-col">
  <div class="mb-12">
    <h2
      class="inline-flex items-center gap-3 text-2xl font-bold text-gray-100"
    >
      <ProfileCheckIcon class="size-6 text-emerald-400" />
      {i18n.HOME.ABOUT_ME}
      <span class="h-px flex-1 bg-gray-800 ml-2"></span>
    </h2>
  </div>

  <div class="flex flex-col gap-8 md:flex-row md:items-start">
    <div class="shrink-0">
      <Image
        alt="Alejandro P. Lezama"
        class="size-24 rounded-2xl border border-gray-800 object-cover md:size-32"
        src="/avatar-optimized.webp"
        width={256}
        height={256}
      />
    </div>

    <div class="flex-1 space-y-4 text-gray-400 leading-relaxed">
      <p>{ABOUT.CONTENT1}</p>
      <p>{ABOUT.CONTENT2}</p>
      <p>{ABOUT.CONTENT3}</p>
    </div>
  </div>
</div>
