---
interface Props {
  type: "web" | "mobile" | "backend";
}

const { type } = Astro.props;

const config = {
  web: {
    label: "Web",
    class: "bg-blue-500/10 text-blue-400 border-blue-500/30",
  },
  mobile: {
    label: "Mobile",
    class: "bg-purple-500/10 text-purple-400 border-purple-500/30",
  },
  backend: {
    label: "Backend",
    class: "bg-amber-500/10 text-amber-400 border-amber-500/30",
  },
};

const { label, class: badgeClass } = config[type];
---

<span class={`inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-xs font-medium ${badgeClass}`}>
  {label}
</span>
