---
interface Props {
  TITLE: string;
  COMPANY: string;
  DESCRIPTION: string;
  DATE: string;
  featured?: boolean;
}

const { TITLE, COMPANY, DESCRIPTION, DATE, featured } = Astro.props;
---

<div
  class={`group relative rounded-xl border border-gray-800 bg-gray-900/50 p-6 transition hover:border-emerald-500/30 hover:bg-gray-900 hover:shadow-lg hover:shadow-emerald-500/5 ${
    featured ? "md:flex md:gap-8" : ""
  }`}
>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-emerald-500/20 to-transparent opacity-0 group-hover:opacity-100 transition"></div>

  <div class={featured ? "md:w-1/3" : ""}>
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 rounded-md bg-emerald-500/10 px-2 py-0.5 text-xs font-mono text-emerald-400">
        {DATE}
      </span>
    </div>
    <h3 class="text-lg font-semibold text-gray-100">{TITLE}</h3>
    <p class="text-sm text-gray-400 mt-0.5">{COMPANY}</p>
  </div>

  <div class={featured ? "md:w-2/3 mt-4 md:mt-0" : "mt-4"}>
    <p class="text-sm text-gray-400 leading-relaxed">{DESCRIPTION}</p>
  </div>
</div>
