---
import Badge from "../components/Badge.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import MailIcon from "../icons/Mail.astro";
import SocialPill from "../components/SocialPill.astro";
import { getI18N } from "../i18n";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <!-- <img
      class="rounded-full shadow-lg size-16"
      src=""
      alt="alez2312p"
    /> -->
    <a
      href="https://linkedin.com/in/alejandro-perez-lezama"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{i18n.HOME.AVAILABLE}</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {i18n.HOME.HELLO}
  </h1>
  <p class="mt-6 text-xl text-gray-800 dark:text-gray-300">
    <strong class="dark:text-red-400 text-red-600 ont-semibold"
      >{i18n.HOME.YEARS_EXPERIENCE}</strong
    >
    {i18n.HOME.INTRO}
    <strong class="dark:text-red-400 text-red-600 ont-semibold"
      >{i18n.HOME.JOB_TITLE}</strong
    >
    {i18n.HOME.CONTENT}
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:alejandropl2509@gmail.com">
      <MailIcon class="size-4" />
      {i18n.HOME.CONTACT_ME}
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/alejandro-perez-lezama/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
